### Nave — link de pago
@naveToken = {{naveAuth.response.body.$.access_token}}
POST {{naveApiBase}}/payment_requests/ecommerce
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{naveToken}}

{
  "external_payment_id": "order-111",
  "seller": {
    "pos_id": "{{navePosId}}"
  },
  "transactions": [
    {
      "amount": {
        "currency": "ARS",
        "value": "177.00"
      },
      "products": [
        {
          "name": "Nave product",
          "description": "Nave description",
          "quantity": 1,
          "unit_price": {
            "currency": "ARS",
            "value": "177.00"
          }
        }
      ]
    }
  ],
  "buyer": {
    "doc_type": "DNI",
    "doc_number": "30123456",
    "name": "User Platform",
    "user_email": "user.platform@platform.com",
