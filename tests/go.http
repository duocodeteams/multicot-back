### 15) POST Coberturas — idseguro = ProductoId del GET
POST {{base_url}}/api/Cobertura
Content-Type: application/json

{
  "idseguros": [19355],
  "idcultura": "es-ES"
}

#
# Nacional verificado: PaisHasta=1009 → GO! Nacional (ProductoId 19355), PET, Multitrip
# Latam 1002 → catálogo internacional (365, Adventure, Smart, etc.)
# PaisHasta=32 (código país AR) → ERROR, no usar
#
